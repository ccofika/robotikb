# PRE-PROD (lokalno) okruzenje za robotikb, samo za Robotik Security. NIKAD ne stavljati produkcione vrednosti ovde.
# Pravi fajl je env/backend.env (nije na gitu). Napravi ga sa: security.ps1 env   (ili: node scripts/make-env.js)
# make-env popuni prazne kljuceve oznacene sa <generise se> nasumicnim lokalnim vrednostima i doda prazne
# kljuceve koji postoje u <koren>/robotikb/.env (start-backend.js odbija start ako neki kljuc fali).
NODE_ENV=development
PORT=5300
BASE_URL=http://localhost:5300
MONGODB_URI=mongodb://127.0.0.1:27118/robotik_preprod_security
MONGO_URI=mongodb://127.0.0.1:27118/robotik_preprod_security
# <generise se>
JWT_SECRET=
# <generise se>
INTERNAL_API_KEY=
CORS_EXTRA_ORIGINS=http://localhost:3300,http://localhost:8082
# Mejlovi idu u lokalni Mailpit (UI: http://localhost:8026)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SERVICE=
GMAIL_SMTP_PORT=1026
EMAIL_USER=preprod@robotik.local
EMAIL_PASS=preprod-local
MAILGUN_USERNAME=
MAILGUN_PASSWORD=
UNCONTACTED_ALERT_EMAILS=admin-preprod@robotik.local
# AI iskljucen u pre-prod (prazan kljuc)
OPENAI_API_KEY=
# Cloudinary prazan: slike i dokumenti Security modula idu na lokalni disk (uploads/security)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# <generise se>
REVIEW_WEBHOOK_SECRET=
REVIEW_SURVEY_URL=http://localhost:3100/preprod-survey
# <generise se> (web push obavestenja; prazno = iskljuceno)
VAPID_PUBLIC_KEY=
# <generise se>
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:preprod@robotik.local

# Security modul (samo lokalno)
SECURITY_TEST_HOOKS=1
WEB_APP_URL=http://localhost:3300
SECURITY_ALERT_EMAILS=
